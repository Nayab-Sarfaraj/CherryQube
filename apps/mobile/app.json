{
  "expo": {
    "name": "CherryQube",
    "slug": "cherryqube",
    "owner": "nayy001",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cherryqube",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.cherryqube.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8F2E2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.cherryqube.app",
      "versionCode": 1,
      "allowBackup": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-dev-client",
        {
          "toolsButton": false,
          "showMenuAtLaunch": false
        }
      ],
      "@clerk/expo",
      [
        "@clerk/expo-native-components",
        {
          "theme": "./clerk-theme.json"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F2E2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow CherryQube to use a photo in your greeting.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "cd74a18f-cfce-4eff-a603-990ca2083dcc"
      }
    }
  }
}
