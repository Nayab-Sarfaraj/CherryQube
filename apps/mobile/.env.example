# Web App Origin that the mobile WebView connects to.
# For production Play Store builds, use your deployed HTTPS web address (e.g. https://cherry-qube.vercel.app).
# For Android emulator local dev: http://10.0.2.2:3000 (handled automatically if unset).
# For physical device local dev: http://<YOUR_LAN_IP>:3000.
EXPO_PUBLIC_WEB_ORIGIN=https://cherry-qube.vercel.app

# Clerk Publishable Key for native authentication and WebView session handoff.
# Use pk_live_... for Play Store production or pk_test_... for development.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Google OAuth Client IDs (Google Cloud Console -> APIs & Services -> Credentials)
# Required for native Google Sign-In with Clerk on Android.
EXPO_PUBLIC_CLERK_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Optional: Set to "true" when running automated tests or simulating a physical device
# EXPO_PUBLIC_PHYSICAL_DEVICE=false
