MONGODB_URI=<your_mongodb_connection_uri>
APP_BASE_URL=<your_web_app_origin>
# Relative to apps/web. Keep web and worker in the same directory.
LOCAL_MEDIA_DIR=<local_media_directory>
# Optional production upload storage. When unset, uploads remain local.
# This is intentionally separate from REMOTION_BUCKET_NAME/S3_BUCKET.
S3_UPLOADS_BUCKET=<private_uploads_bucket>
AWS_REGION=us-east-1
# Configure all three for account flows and Clerk webhook verification.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<your_clerk_publishable_key>
CLERK_SECRET_KEY=<your_clerk_secret_key>
CLERK_WEBHOOK_SECRET=<your_clerk_webhook_signing_secret>
# Polar billing. Keep sandbox while configuring and testing.
POLAR_ENVIRONMENT=<sandbox_or_production>
POLAR_ACCESS_TOKEN=<your_polar_access_token>
POLAR_WEBHOOK_SECRET=<your_polar_webhook_secret>
# JSON: [{"id":"single","productId":"<Polar product UUID>","credits":1}]
# Prices and names are fetched from the corresponding Polar one-time product.
POLAR_PACKS=<your_polar_pack_json>
# Both are required before checkout can be enabled.
BILLING_SELLER_NAME=<your_legal_seller_name>
SUPPORT_EMAIL=<your_support_email>
# Optional. Without a key, the message writer returns curated suggestions.
ANTHROPIC_API_KEY=<your_anthropic_api_key>
ANTHROPIC_MODEL=<your_anthropic_model>
# The mobile build and its matching web deployment must use the same Clerk instance.
EXPO_PUBLIC_WEB_ORIGIN=<your_web_app_origin>
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=<your_clerk_publishable_key>
EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID=<your_google_web_client_id>
EXPO_PUBLIC_CLERK_GOOGLE_ANDROID_CLIENT_ID=<your_google_android_client_id>
# Keep paid exports disabled until billing is launched and verified.
NEXT_PUBLIC_ENABLE_PAID_EXPORTS=false
# Keep the AI message writer hidden until it is ready for launch.
NEXT_PUBLIC_ENABLE_AI_WRITER=false
# Scheduled recovery sweep secret (e.g. Vercel Cron)
CRON_SECRET=<your_cron_secret>
